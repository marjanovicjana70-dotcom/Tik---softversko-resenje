<UserControl x:Class="JanaTakmicenje22.Views.Pages.ChallengesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="MainGrid" Background="#FFFFFF" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                            <ThicknessAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Border x:Name="RewardOverlay" Background="#B22B5D8C" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#3D6B99" CornerRadius="24" Padding="48,40" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.4" Color="#2B5D8C"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="RewardEmoji" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="RewardTitle" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="RewardXPLabel" FontSize="32" FontWeight="Bold" Foreground="#96C0D9" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="RewardBadgeLabel" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,32" TextWrapping="Wrap" Visibility="Collapsed" Opacity="0.9"/>

                    <Button Content="Nastavi! ✮⋆˙" Click="CloseReward_Click" HorizontalAlignment="Center" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="#FFFFFF" CornerRadius="12" Padding="32,14">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#3D6B99" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#F0F4F8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#EAF1F6" BorderThickness="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,36,28,24">
                        <TextBlock Text="Izazovi" FontSize="28" FontWeight="Bold" Foreground="#2B5D8C"/>
                        <TextBlock x:Name="ProgressSummary" FontSize="14" Foreground="#7CADCC" Margin="0,6,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <ListBox x:Name="ChallengesList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ChallengesList_SelectionChanged" Margin="0,0,0,16">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="16,4,16,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="12" Padding="16,14">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                           
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F4F8FB"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3D6B99"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="NumBorder" Grid.Column="0" Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0" Background="#96C0D9">
                                        <TextBlock x:Name="NumText" Text="{Binding Challenge.Order}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="{Binding Challenge.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#2B5D8C" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SubText" Text="Završen" FontSize="12" Foreground="#7CADCC" Visibility="Collapsed" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding StatusEmoji}" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                        <Setter TargetName="NumBorder" Property="Background" Value="#F0F4F8"/>
                                        <Setter TargetName="NumText" Property="Foreground" Value="#96C0D9"/>
                                        <Setter TargetName="TitleText" Property="Text" Value="🔒 Zaključano"/>
                                        <Setter TargetName="TitleText" Property="Foreground" Value="#96C0D9"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter TargetName="NumBorder" Property="Background" Value="#7CADCC"/>
                                        <Setter TargetName="SubText" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>

 
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="TitleText" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="SubText" Property="Foreground" Value="#96C0D9"/>
                                        <Setter TargetName="NumBorder" Property="Background" Value="#FFFFFF"/>
                                        <Setter TargetName="NumText" Property="Foreground" Value="#3D6B99"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#F8FAFC">

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <Image Source="pack://application:,,,/Assets/pingvin5.png" Width="96" Height="96" Margin="0,0,0,24" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                       
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="10" Duration="0:0:1.5">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                    <TextBlock Text="Izaberi izazov" FontSize="24" FontWeight="Bold" Foreground="#2B5D8C" HorizontalAlignment="Center"/>
                    <TextBlock Text="Klikni na izazov sa leve strane da vidiš detalje." FontSize="15" Foreground="#7CADCC" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="40">
                    <Border Background="#FFFFFF" CornerRadius="20" Padding="48" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,40">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.04" Color="#2B5D8C"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border HorizontalAlignment="Left" Background="#96C0D9" CornerRadius="12" Padding="14,6" Margin="0,0,0,24">
                                <TextBlock x:Name="DetailNumber" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>

                            <TextBlock x:Name="DetailTitle" FontSize="36" FontWeight="Bold" Foreground="#2B5D8C" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="42"/>

                            <TextBlock x:Name="DetailDescription" FontSize="17" Foreground="#3D6B99" TextWrapping="Wrap" LineHeight="28" Margin="0,0,0,48" Opacity="0.9"/>

                            <Border HorizontalAlignment="Left" Background="#F8FAFC" BorderBrush="#EAF1F6" BorderThickness="2" CornerRadius="14" Padding="20,14" Margin="0,0,0,40">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="˗ˏˋ ♡ ˎˊ˗" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailXP" FontSize="18" FontWeight="Bold" Foreground="#3D6B99" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="CompleteBtn" Click="CompleteBtn_Click" HorizontalAlignment="Left" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="#3D6B99" CornerRadius="14" Padding="36,18">
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#2B5D8C"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#96C0D9"/>
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>