<UserControl x:Class="JanaTakmicenje22.Views.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootContent"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetName="LeftPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-28" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FormPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="28" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Border x:Name="RootContent" Opacity="0" Background="#7CADCC">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="LeftPanel"
                    CornerRadius="18" Margin="0,0,14,0" Background="#96C0D9">
                <Border.RenderTransform>
                    <TranslateTransform X="-28"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#03131F" Opacity="0.35"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">

                    <Border Width="96" Height="96" CornerRadius="48"
                            HorizontalAlignment="Center" Margin="0,0,0,22" Background="#7CADCC">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#3D6B99" Opacity="0.5"/>
                        </Border.Effect>
                        <Image Source="/Assets/logo3.png" Width="64" Height="64"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Dobrodošao!"
                               FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="Nedostajao si Tiku..Nastavi tamo gde si stao."
                               FontSize="13" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="20"/>

                    <Border Height="1" Width="40" HorizontalAlignment="Center"
                            Background="#376D99" Margin="0,22,0,22"/>

                    <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,8" Background="#7CADCC">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ദ്ദി◝ ⩊ ◜.ᐟ" FontSize="9" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="White"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="40 izazova.." FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="van zone komfora" FontSize="11" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="14,11" Background="#7CADCC">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ദ്ദി◝ ⩊ ◜.ᐟ" FontSize="9" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="White"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="privatnost" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="samo ti imaš pristup" FontSize="11" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="18" Background="#EDF8FF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.22"/>
                </Border.Effect>

                <StackPanel x:Name="FormPanel"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Width="270" Margin="36">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="28"/>
                    </StackPanel.RenderTransform>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Image Source="/Assets/logo2.png" Width="34" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Prijavi se" FontSize="27" FontWeight="Bold"
                                   Foreground="#4A7AAB" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Unesi svoje podatke da bi nastavio"
                               FontSize="13" Foreground="#4A7AAB" Margin="0,0,0,26"/>

                    <TextBlock Text="KORISNIČKO IME ILI EMAIL"
                               FontSize="11" FontWeight="SemiBold" Foreground="#4A7AAB" Margin="0,0,0,6"/>
                    <Border CornerRadius="12" Background="White"
                            BorderBrush="#C2DCEF" BorderThickness="1.5" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#0F3460"/>
                        </Border.Effect>
                        <TextBox x:Name="UsernameBox" Background="Transparent" BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="15" Foreground="#7CADCC" Padding="14,12"/>
                    </Border>

                    <TextBlock Text="LOZINKA"
                               FontSize="11" FontWeight="SemiBold" Foreground="#4A7AAB" Margin="0,0,0,6"/>
                    <Border CornerRadius="12" Background="White"
                            BorderBrush="#C2DCEF" BorderThickness="1.5" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#0F3460"/>
                        </Border.Effect>
                        <PasswordBox x:Name="PasswordBox" Background="Transparent" BorderThickness="0"
                                     FontFamily="Segoe UI" FontSize="15" Foreground="#7CADCC" Padding="14,12"/>
                    </Border>

                    <TextBlock x:Name="ErrorText" Foreground="#8A1C1C" FontSize="13"
                               Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Button x:Name="LoginBtn" HorizontalAlignment="Stretch"
                            Margin="0,12,0,20" Cursor="Hand" Click="LoginBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="12" Padding="0,13" Background="#7CADCC">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#2B5D8C"/>
                                    </Border.Effect>
                                    <TextBlock Text="Prijavi se" Foreground="White"
                                               FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Bg"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.82" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Bg"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Nemaš nalog? " FontSize="13" Foreground="#4A7AAB"/>
                        <Button x:Name="RegisterBtn" Cursor="Hand" Padding="0"
                                Background="Transparent" BorderThickness="0" Click="RegisterBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="Registruj se" Foreground="#2B5D8C"
                                               FontSize="13" FontWeight="Bold" TextDecorations="Underline"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.65"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
